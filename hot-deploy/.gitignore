**/.vscode/
.settings/
**/.settings/
.classpath
.project
.factorypath
.apt_generated/
.springBeans
.sts4-cache/
*.iml
*.ipr
*.iws
out/
**/out/

# Local environment and secrets
.env
.env.*
!.env.example

# Logs, JVM diagnostics, and temporary files
*.log
*.pid
*.tmp
*.temp
*.swp
*.swo
*~
hs_err_pid*
replay_pid*
*.hprof
*.jfr

# OS metadata
.DS_Store
._*
Thumbs.db

