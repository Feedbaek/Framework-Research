# Codex / oh-my-codex local state
.omx/
**/.omx/

# Gradle caches and generated outputs
.gradle/
**/.gradle/
build/
**/build/
bin/
**/bin/

# Do not hide source packages that happen to be named build or bin
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/bin/
!**/src/test/**/bin/

# Local hot-deploy artifact repository
/deployments/

# IDE metadata
.idea/
**/.idea/
